# Optional settings. Tenant sign-in needs no entries here — the app uses
# Microsoft's first-party client with device-code sign-in, so no Entra app
# registration or client/tenant IDs are required.
#
# The app reads this file from %APPDATA%\M365Tools\.env — the Settings page
# manages it for you.

# Syncro MSP integration (used to add contacts when accounts are created)
SYNCRO_SUBDOMAIN=
SYNCRO_API_KEY=
